POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=replace-with-a-long-random-password
LEDGER_DATABASE_URL=postgresql+asyncpg://ledger:replace-with-a-long-random-password@db:5432/ledger
LEDGER_API_PORT=8000
# Values are UTF-8 secrets, or use base64:<base64-data>. Each decoded key must be >= 32 bytes.
LEDGER_HMAC_KEYS_JSON={"v1":"replace-this-with-at-least-32-random-bytes"}
LEDGER_CURRENT_KEY_VERSION=v1
LEDGER_SEAL_BATCH_SIZE=100
LEDGER_SEAL_POLL_SECONDS=2
LEDGER_EXPORT_POLL_SECONDS=2
LEDGER_EXPORT_LEASE_SECONDS=120
LEDGER_LOG_LEVEL=INFO
